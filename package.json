{
    "name": "guestbook",
    "type": "module",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "setup": "node initialize.js",
        "bindings": "pnpm --filter \"./packages/*\" run build",
        "dev": "pnpm run bindings && vite dev",
        "build": "pnpm run bindings && vite build",
        "preview": "vite preview",
        "check": "pnpm run bindings && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "pnpm run bindings && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "prettier --check . && eslint .",
        "format": "prettier --write ."
    },
    "dependencies": {
        "@lucide/svelte": "^1.70.0",
        "@stellar/stellar-sdk": "^16.4.1",
        "@tailwindcss/vite": "^4.3.5",
        "smart-account-kit": "^0.10.0"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.1",
        "@eslint/js": "^10.0.1",
        "@skeletonlabs/skeleton": "^5.0.4",
        "@skeletonlabs/skeleton-svelte": "^5.0.4",
        "@sveltejs/adapter-vercel": "^7.0.2",
        "@sveltejs/kit": "^3.1.1",
        "@sveltejs/load-config": "^0.2.3",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/forms": "^0.5.11",
        "@types/eslint": "^9.6.1",
        "@types/node": "^26.6.6",
        "@typescript-eslint/eslint-plugin": "^8.72.1",
        "@typescript-eslint/parser": "^8.72.1",
        "dotenv": "^18.0.9",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.24.1",
        "glob": "^14.0.4",
        "globals": "^17.14.0",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte": "^5.57.3",
        "svelte-check": "^4.7.8",
        "tailwindcss": "^4.3.5",
        "tslib": "^2.9.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.6",
        "ye_olde_guestbook": "workspace:*"
    },
    "engines": {
        "node": "26"
    },
    "packageManager": "pnpm@12.18.0",
    "imports": {
        "#lib": "./src/lib/index.js",
        "#lib/*": "./src/lib/*"
    }
}
