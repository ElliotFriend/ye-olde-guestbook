# The network passphrase and RPC url are used to connect to the network
PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
PUBLIC_STELLAR_RPC_URL="https://soroban-testnet.stellar.org"

# The network name and account here are used by the initialization script, which
# runs some commands from the Stellar CLI
PUBLIC_STELLAR_NETWORK=testnet
PUBLIC_STELLAR_ACCOUNT=alice

# Smart account deployment details. The Wasm hash determines the executable code
# deployed each time a user creates a smart account. The verifier validates
# their passkey signatures on-chain. Neither needs to be changed, and both can
# be copy/pasted into any smart account dapp.
PUBLIC_ACCOUNT_WASM_HASH=1b5f4534a76322da2ad7c745f6900857a6802b0ca79850c35a03561df997785a
PUBLIC_WEBAUTHN_VERIFIER_ADDRESS=CC7EKIHQP3TN4CARQDND6CEOY2UXLWWC2X5GHTD5NLAT7BG5GPZIOM3F

# The Stellar Asset Contract address for native XLM on Testnet.
PUBLIC_NATIVE_TOKEN_CONTRACT=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Transactions are submitted through the OpenZeppelin Relayer Channels
# service, which fee-sponsors them from a pool of channel accounts. Our own
# /api/send route proxies to it so the API key stays server-side.
PUBLIC_OZ_CHANNELS_URL="https://channels.openzeppelin.com/testnet"

# OpenZeppelin Relayer Channels credentials. Grab one for Testnet at
# https://channels.openzeppelin.com/testnet/gen
PRIVATE_OZ_CHANNELS_API_KEY="generate-one-from-https://channels.openzeppelin.com/testnet/gen"
